{
  "name": "shoplet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "node --env-file=.env --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test server/*.test.ts",
    "typecheck": "tsc",
    "mcp": "node --env-file=.env server/mcp.ts",
    "mcp:http": "node --env-file=.env server/mcp-http.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.49",
    "@ai-sdk/react": "^4.0.105",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.102",
    "express": "^5.1.0",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^7.0.2",
    "vite": "^7.1.9"
  }
}
