# serpapi (default), brave, or playwright
SEARCH_PROVIDER=serpapi

# Required when SEARCH_PROVIDER=serpapi
SERPAPI_KEY=
# Required when SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=

# Only for SEARCH_PROVIDER=playwright. Run `npx playwright install chromium` once.
# Set to false to watch the browser while debugging a broken selector.
PLAYWRIGHT_HEADLESS=true

# https://cloud.near.ai
NEAR_AI_API_KEY=
# optional, defaults to deepseek-ai/DeepSeek-V3.1
NEAR_AI_MODEL=

# Required only by the remote HTTP MCP server. Generate with: openssl rand -hex 32
MCP_TOKEN=
